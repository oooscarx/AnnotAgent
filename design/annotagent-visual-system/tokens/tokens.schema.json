{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnnotAgent design tokens",
  "type": "object",
  "required": [
    "name",
    "version",
    "schema_version",
    "themes",
    "common"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "schema_version": { "const": 2 },
    "themes": {
      "type": "object",
      "required": ["light", "dark"]
    },
    "common": {
      "type": "object"
    },
    "typography": {
      "type": "object"
    },
    "spacing": {
      "type": "object"
    },
    "radius": {
      "type": "object"
    },
    "shadow": {
      "type": "object"
    },
    "motion": {
      "type": "object"
    },
    "layout": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
