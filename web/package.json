{
  "name": "annotagent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tokens:check": "node ../scripts/generate-tokens.mjs --check",
    "typecheck": "npm run tokens:check && tsc --noEmit",
    "test": "vitest run --exclude 'e2e/**'",
    "build": "npm run tokens:check && tsc --noEmit && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  }
}
